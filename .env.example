# ============================================================
# 千方航空物流平台 - 环境变量配置文件
#
# 使用方式：
#   1. 复制此文件为 .env：  cp .env.example .env
#   2. 修改 .env 中的配置项
#   3. 启动服务：docker-compose up -d
#
# 注意：
#   - 修改 .env 后需要重启服务才能生效
#   - 带有 [必改] 标记的项必须修改为实际值
#   - 带有 [可选] 标记的项可使用默认值
# ============================================================

# ========== 数据库配置 ==========
# [必改] MySQL root 密码（首次启动时设置，后续修改需手动更改 MySQL 密码）
MYSQL_ROOT_PASSWORD=aircargo123456

# [可选] 数据库名称
MYSQL_DATABASE=qianfang_air_cargo

# [可选] MySQL 对外暴露端口（宿主机端口）
MYSQL_EXTERNAL_PORT=3306

# [必改] 应用连接数据库的配置
# Docker 环境中使用服务名 "mysql" 作为主机名
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=aircargo123456

# ========== 应用配置 ==========
# [可选] 应用对外暴露端口
APP_PORT=8000

# [必改] JWT 密钥（请修改为随机字符串，建议 32 位以上）
SECRET_KEY=please-change-this-to-a-random-secret-key-in-production

# [可选] 调试模式（生产环境请设为 False）
DEBUG=False

# ========== RPA API 配置 ==========
# [可选] 以下为 RPA 接口配置，如需修改请取消注释并填写
# RPA_API_BASE_URL=https://z-commander-api.ai-indeed.com
# RPA_API_APP_KEY=56505085de31411d95c7d55d7d77147c
# RPA_API_APP_SECRET=iZfoiSTRiBkTSzpiPTxCfcPuiOtXcC
# RPA_API_COOKIE=JSESSIONID=3251C9354C6364367DF927B56A1E3CCE

# ========== RPA 任务队列配置 ==========
# [可选] 是否启用 RPA 任务队列
# RPA_QUEUE_ENABLED=True

# [可选] Worker 数量
# RPA_QUEUE_WORKER_COUNT=1

# ========== 打印文件配置 ==========
# [可选] RPA 机器人上的文件根目录（需与 RPA 机器人上的共享目录一致）
# RPA_PRINT_FILE_ROOT_PATH=D:\\generated_files_of_qianfang_air_cargo_platform

# [可选] 开单成功后是否自动打印单据；False仅关闭自动打印，不影响手动打印接口
RPA_SHENZHEN_AIR_AUTO_PRINT_AFTER_WAYBILL_ENABLED=True
RPA_CHINA_SOUTHERN_AIR_AUTO_PRINT_AFTER_WAYBILL_ENABLED=True

# ========== 数据库连接池配置 ==========
# [可选] 连接池大小
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=3600

# ========== 保持登录任务运行时间间隔配置 ==========
RPA_CHINA_SOUTHERN_AIR_KEEP_LOGIN_INTERVAL_SECONDS=6600
RPA_SHENZHEN_AIR_KEEP_LOGIN_INTERVAL_SECONDS=6600
RPA_TANGYI_KEEP_LOGIN_INTERVAL_SECONDS=900

# ========== 南航货物类型数据字典自动同步 ==========
# [可选] 服务启动后立即同步；成功后默认每12小时覆盖一次，失败则5分钟后重试
CHINA_SOUTHERN_AIR_CARGO_TYPE_SYNC_ENABLED=True
CHINA_SOUTHERN_AIR_CARGO_TYPE_SYNC_INTERVAL_SECONDS=43200
CHINA_SOUTHERN_AIR_CARGO_TYPE_SYNC_RETRY_SECONDS=300
